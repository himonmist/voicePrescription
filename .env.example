# --- Database (Neon). Pooled URL for the app, direct URL for migrations ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Session/auth (>= 32 random chars: `openssl rand -base64 48`) ---
SESSION_SECRET=

# --- Provider credentials (server-side only; never NEXT_PUBLIC_*) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=

# --- Allowed models per provider (comma separated). Unset = provider cannot execute ---
AI_MODELS_ANTHROPIC=
AI_MODELS_OPENAI=
AI_MODELS_GOOGLE=

# --- Set true ONLY after a signed DPA/BAA covering patient data with that provider ---
ANTHROPIC_APPROVED_FOR_PHI=false
OPENAI_APPROVED_FOR_PHI=false
GOOGLE_APPROVED_FOR_PHI=false

# --- Local development only. Disabled when NODE_ENV=production ---
AI_DEV_MODE=false
