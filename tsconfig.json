{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom","dom.iterable","es2022"], "module": "esnext",
    "moduleResolution": "bundler", "strict": true, "noUncheckedIndexedAccess": true,
    "jsx": "preserve", "incremental": true, "skipLibCheck": true, "noEmit": true,
    "esModuleInterop": true, "resolveJsonModule": true, "isolatedModules": true,
    "allowJs": false, "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
